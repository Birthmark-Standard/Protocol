(* BM_Quorum_Collusion.pv   (v90 design)
Property I (two gatekeepers): with G1 and G2 fully compromised, no quorum forms for a (PacketHash, verdict) pair that C did not check.

Leaked keys: g1_sk, g1_sign_sk, g2_sk, g2_sign_sk.
Two of three boards are attacker-controlled, so a quorum of boards 1 and 2 is free. What the attacker cannot do is make that quorum carry a pair C never signed, because the quorum checks C's signature.

Device identity T1 is private here (the attacker cannot forge a token). The
device takes its claim from the attacker, so every verdict judge(claim) is
reachable. Boards are public: the attacker can read and write them. Honest
gatekeepers and the quorum are as in the pipeline of the other models.

Queries and expected answers.
 1  quorum_reached(p,v) ==> c_checked(p,v)      expected: true
    No quorum forms for a (PacketHash, verdict) pair C did not check.
 2  c_checked_w(p,v,w) ==> v_issued(v,w) && c_asked(p,w)      expected: true
    C accepts only a verdict V issued for a wrapped value C itself sent.
 3  event(quorum_reached(p,v))      expected: "not event(quorum_reached(p,v)) is false"
    Sanity: a quorum is reachable, so 1 and 2 are not true because the pipeline is dead.
THIS FILE IS THE TWIN. Fault: the quorum of boards 1 and 2 does not verify C's signature. Expected: NOT equivalent (or the query FAILS). *)

type skey.
type pkey.
type key.

fun pk(skey): pkey.
fun aenc(bitstring, pkey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey, rnd: bitstring; adec(aenc(m, pk(sk), rnd), sk) = m.

fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, sk: skey; checksign(sign(m, sk), pk(sk)) = m.

fun hash(bitstring): bitstring.
fun judge(bitstring): bitstring.

free pub: channel.
free c_to_val: channel [private].
free val_to_c: channel [private].
free match_board_1: channel.
free match_board_2: channel.
free match_board_3: channel.
free quorum_out: channel [private].
free registry: channel.

free v_token_sk: skey [private].
free v_sign_sk: skey [private].
free c_device_sk: skey [private].
free c_sign_sk: skey [private].
free f_device_sk: skey [private].
free i_device_sk: skey [private].
free g1_sk: skey [private].
free g1_sign_sk: skey [private].
free g2_sk: skey [private].
free g2_sign_sk: skey [private].
free g3_sk: skey [private].
free g3_sign_sk: skey [private].

free T1: bitstring [private].
free T2: bitstring [private].
free imgX: bitstring.
free imgY: bitstring.
free claimX: bitstring.
free claimY: bitstring.
free v_ok: bitstring.
free v_no: bitstring.
free no_sig: bitstring.

event v_issued(bitstring, bitstring).
event c_asked(bitstring, bitstring).
event c_checked(bitstring, bitstring).
event c_checked_w(bitstring, bitstring, bitstring).
event quorum_reached(bitstring, bitstring).

query p: bitstring, v: bitstring; event(quorum_reached(p, v)) ==> event(c_checked(p, v)).
query p: bitstring, v: bitstring, w: bitstring; event(c_checked_w(p, v, w)) ==> event(v_issued(v, w)) && event(c_asked(p, w)).
query p: bitstring, v: bitstring; event(quorum_reached(p, v)).

let device(token: bitstring, content: bitstring, claim: bitstring) =
    let h = hash(content) in
    new n: bitstring;
    let packethash = hash((h, n)) in
    new rnd_token: bitstring;
    let enc_token = aenc((token, claim), pk(v_token_sk), rnd_token) in
    new rnd_bundle: bitstring;
    let enc_bundle = aenc((enc_token, packethash), pk(c_device_sk), rnd_bundle) in
    new rnd_f: bitstring;
    let enc_content_f = aenc((h, n), pk(f_device_sk), rnd_f) in
    out(pub, enc_content_f);
    out(pub, enc_bundle).

let credential_processor =
    !
    in(pub, enc_bundle_in: bitstring);
    let (enc_token_in: bitstring, packethash_in: bitstring) = adec(enc_bundle_in, c_device_sk) in
    new blindshare_key: key;
    let wrapped = senc(packethash_in, blindshare_key) in
    event c_asked(packethash_in, wrapped);
    out(c_to_val, (enc_token_in, wrapped));
    in(val_to_c, (decision: bitstring, sig_in: bitstring));
    if decision = v_ok then
    (
        let (verdict_in: bitstring, wrapped_checked: bitstring) = checksign(sig_in, pk(v_sign_sk)) in
        let packethash_confirmed = sdec(wrapped_checked, blindshare_key) in
        if packethash_confirmed = packethash_in then
        (
            event c_checked(packethash_in, verdict_in);
            event c_checked_w(packethash_in, verdict_in, wrapped_checked);
            let c_signed = sign((packethash_in, verdict_in), c_sign_sk) in
            new rnd_g1: bitstring;
            let pkt_g1 = aenc((packethash_in, verdict_in, sig_in, blindshare_key, c_signed), pk(g1_sk), rnd_g1) in
            new rnd_g2: bitstring;
            let pkt_g2 = aenc((packethash_in, verdict_in, sig_in, blindshare_key, c_signed), pk(g2_sk), rnd_g2) in
            new rnd_g3: bitstring;
            let pkt_g3 = aenc((packethash_in, verdict_in, sig_in, blindshare_key, c_signed), pk(g3_sk), rnd_g3) in
            ( out(pub, pkt_g1) | out(pub, pkt_g2) | out(pub, pkt_g3) )
        )
    ).

let validator =
    !
    in(c_to_val, (enc_token_in: bitstring, wrapped_in: bitstring));
    let (token_in: bitstring, claim_in: bitstring) = adec(enc_token_in, v_token_sk) in
    if (token_in = T1) || (token_in = T2) then
    (
        event v_issued(judge(claim_in), wrapped_in);
        out(val_to_c, (v_ok, sign((judge(claim_in), wrapped_in), v_sign_sk)))
    )
    else
        out(val_to_c, (v_no, no_sig)).

let gatekeeper_3 =
    !
    in(pub, pkt_in: bitstring);
    let (p: bitstring, verdict: bitstring, sig: bitstring, k: key, c_sig: bitstring) = adec(pkt_in, g3_sk) in
    let (verdict_checked: bitstring, wrapped_checked: bitstring) = checksign(sig, pk(v_sign_sk)) in
    if verdict_checked = verdict then
    (
        let p_confirmed = sdec(wrapped_checked, k) in
        let (c_p: bitstring, c_verdict: bitstring) = checksign(c_sig, pk(c_sign_sk)) in
        if (p_confirmed = p) && (c_p = p) && (c_verdict = verdict) then
        (
            let g3_signed = sign(c_sig, g3_sign_sk) in
            ( out(match_board_3, g3_signed) | out(match_board_3, g3_signed) )
        )
    ).

let quorum_12 =
    !
    in(match_board_1, s1: bitstring);
    in(match_board_2, s2: bitstring);
    let (p1: bitstring, v1: bitstring) = checksign(s1, pk(g1_sign_sk)) in
    let (p2: bitstring, v2: bitstring) = checksign(s2, pk(g2_sign_sk)) in
    if (p1 = p2) && (v1 = v2) then
    ( event quorum_reached(p1, v1); ( out(quorum_out, (p1, v1)) | out(quorum_out, (p1, v1)) ) ).

let quorum_13 =
    !
    in(match_board_1, s1: bitstring);
    in(match_board_3, s3: bitstring);
    let c1 = checksign(s1, pk(g1_sign_sk)) in
    let (p1: bitstring, v1: bitstring) = checksign(c1, pk(c_sign_sk)) in
    let c3 = checksign(s3, pk(g3_sign_sk)) in
    let (p3: bitstring, v3: bitstring) = checksign(c3, pk(c_sign_sk)) in
    if (p1 = p3) && (v1 = v3) then
    ( event quorum_reached(p1, v1); ( out(quorum_out, (p1, v1)) | out(quorum_out, (p1, v1)) ) ).

let quorum_23 =
    !
    in(match_board_2, s2: bitstring);
    in(match_board_3, s3: bitstring);
    let c2 = checksign(s2, pk(g2_sign_sk)) in
    let (p2: bitstring, v2: bitstring) = checksign(c2, pk(c_sign_sk)) in
    let c3 = checksign(s3, pk(g3_sign_sk)) in
    let (p3: bitstring, v3: bitstring) = checksign(c3, pk(c_sign_sk)) in
    if (p2 = p3) && (v2 = v3) then
    ( event quorum_reached(p2, v2); ( out(quorum_out, (p2, v2)) | out(quorum_out, (p2, v2)) ) ).

process
    out(pub, pk(v_token_sk));
    out(pub, pk(v_sign_sk));
    out(pub, pk(c_device_sk));
    out(pub, pk(c_sign_sk));
    out(pub, pk(f_device_sk));
    out(pub, pk(i_device_sk));
    out(pub, g1_sk);
    out(pub, g1_sign_sk);
    out(pub, g2_sk);
    out(pub, g2_sign_sk);
    out(pub, pk(g3_sk));
    out(pub, pk(g3_sign_sk));
    (
        !(in(pub, claim_a: bitstring); device(T1, imgX, claim_a))
        | credential_processor
        | validator
        | gatekeeper_3
        | quorum_12
        | quorum_13
        | quorum_23
    )
