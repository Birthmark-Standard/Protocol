(* BM_Token_Binding_TWIN.pv   (v105 design, token binding and single use, serialized check)
TWIN: the validator does not compare the binding hash in the token with the wrapped FullPacketHash C presents. It still claims the nonce atomically, as in the model. Expected result: the first query is false (a verdict is issued for a wrapped value the device never committed to), and so is the injective query.

Everything else is as in BM_Token_Binding.pv. Expected: queries (1) and (1b) false, query (2) false. *)

type skey.
type pkey.
type key.

fun pk(skey): pkey.
fun aenc(bitstring, pkey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey, rnd: bitstring; adec(aenc(m, pk(sk), rnd), sk) = m.

fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

fun hash(bitstring): bitstring.

free pub: channel.

free v_token_sk: skey [private].
free cred: bitstring [private].
free claim: bitstring.

event dev_committed(bitstring, bitstring).
event v_issued(bitstring, bitstring).
event nonce_recorded(bitstring, bitstring).

restriction rn: bitstring, id1: bitstring, id2: bitstring; event(nonce_recorded(rn, id1)) && event(nonce_recorded(rn, id2)) ==> id1 = id2.

query rn: bitstring, e: bitstring; event(v_issued(rn, e)) ==> event(dev_committed(rn, e)).
query rn: bitstring, e: bitstring; inj-event(v_issued(rn, e)) ==> inj-event(dev_committed(rn, e)).
query rn: bitstring, e: bitstring; event(v_issued(rn, e)).

let device =
    !
    new rn: bitstring;
    new fullpackethash: bitstring;
    new blindshare_key: key;
    let wrapped_dev = senc(fullpackethash, blindshare_key) in
    let binding = hash(wrapped_dev) in
    event dev_committed(rn, wrapped_dev);
    new rnd_token: bitstring;
    let enc_token = aenc((cred, rn, claim, binding), pk(v_token_sk), rnd_token) in
    out(pub, (enc_token, fullpackethash, blindshare_key)).


let validator =
    !
    in(pub, (enc_token_in: bitstring, wrapped_in: bitstring));
    let (cred_in: bitstring, rn_in: bitstring, claim_in: bitstring, binding_in: bitstring) = adec(enc_token_in, v_token_sk) in
    if (cred_in = cred) then
        new run_id: bitstring;
        event nonce_recorded(rn_in, run_id);
        event v_issued(rn_in, wrapped_in).

process
    out(pub, pk(v_token_sk));
    (
        device
        | validator
    )
