(* BM_CredentialChannelServer_Compromise.pv   (v105 design, identity swap, full pipeline)
Property D: a fully compromised credential channel server C learns nothing about which device holds which token.

What is leaked: c_device_sk and c_sign_sk, all of C's keys. The attacker plays C: it opens every bundle, so it holds each device's FullPacketHash and
BlindShare_key, and it can send the validator any (token, wrapped) pair and read the answer, so V is an oracle on pub. It can also build and send the
gatekeeper packets, signed with c_sign_sk, so it can trigger postings. Every other key stays private.

What runs behind C: the honest validator, the three gatekeepers with their match boards, the three quorums, content channel servers F and I, and the
registry. The boards and the quorum output are private (Registry Node access only). The registry output is public. A compromised C can therefore force a
posting for any FullPacketHash whose wrapped value V has signed, and read the record that results. The relay layer is not modeled: the device writes to the
public channel, which gives every observer every ciphertext.

What is swapped: the device identity. Device identities T1, T2 and contents imgX, imgY are PUBLIC names, so the attacker can name a candidate identity.
device(choice[T1,T2], imgX, ...) | device(choice[T2,T1], imgY, ...): the same contents are authenticated in both worlds, the credentials trade places.
With private T1, T2 the two worlds are the same world with two names exchanged, and the model would be true for any protocol; with public names it is not.

What "true" means: nothing C can see, ask V, or learn from the registry (token blob, FullPacketHash, verdict, V's signature, the records that its own
postings produce) distinguishes T1-then-T2 from T2-then-T1. This is token confidentiality at C's vantage point. It does not by itself say anything about
content, because the contents are the same in both worlds.

What would make it false: the twin in twins/ makes V fold the credential into the verdict, judge((claim, token)). C then reads the credential in V's reply
and the worlds differ. That twin must come out NOT equivalent, or this model's "true" proves nothing. *)

type skey.
type pkey.
type key.

fun pk(skey): pkey.
fun aenc(bitstring, pkey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey, rnd: bitstring; adec(aenc(m, pk(sk), rnd), sk) = m.

fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, sk: skey; checksign(sign(m, sk), pk(sk)) = m.

fun hash(bitstring): bitstring.
fun judge(bitstring): bitstring.

free pub: channel.
free match_board_1: channel [private].
free match_board_2: channel [private].
free match_board_3: channel [private].
free quorum_out: channel [private].
free registry: channel.

free v_token_sk: skey [private].
free v_sign_sk: skey [private].
free c_device_sk: skey [private].
free c_sign_sk: skey [private].
free f_device_sk: skey [private].
free i_device_sk: skey [private].
free g1_sk: skey [private].
free g1_sign_sk: skey [private].
free g2_sk: skey [private].
free g2_sign_sk: skey [private].
free g3_sk: skey [private].
free g3_sign_sk: skey [private].

free T1: bitstring.
free T2: bitstring.
free imgX: bitstring.
free imgY: bitstring.
free claimX: bitstring.
free claimY: bitstring.
free v_ok: bitstring.
free v_no: bitstring.
free no_sig: bitstring.

let device(token: bitstring, content: bitstring, claim: bitstring) =
    let h = hash(content) in
    new n: bitstring;
    let fullpackethash = hash((h, n)) in
    new rnd_token: bitstring;
    new blindshare_key: key;
    let wrapped_dev = senc(fullpackethash, blindshare_key) in
    let binding = hash(wrapped_dev) in
    let enc_token = aenc((token, claim, binding), pk(v_token_sk), rnd_token) in
    new rnd_bundle: bitstring;
    let enc_bundle = aenc((enc_token, fullpackethash, blindshare_key), pk(c_device_sk), rnd_bundle) in
    new rnd_f: bitstring;
    let enc_content_f = aenc((h, n), pk(f_device_sk), rnd_f) in
    new rnd_i: bitstring;
    let enc_content_i = aenc((h, n), pk(i_device_sk), rnd_i) in
    out(pub, enc_content_i);
    out(pub, enc_content_f);
    out(pub, enc_bundle).

let validator =
    !
    in(pub, (enc_token_in: bitstring, wrapped_in: bitstring));
    let (token_in: bitstring, claim_in: bitstring, binding_in: bitstring) = adec(enc_token_in, v_token_sk) in
    if ((token_in = T1) || (token_in = T2)) && (binding_in = hash(wrapped_in)) then
    (
        out(pub, (v_ok, sign((judge(claim_in), wrapped_in), v_sign_sk)))
    )
    else
        out(pub, (v_no, no_sig)).

let gatekeeper_1 =
    !
    in(pub, pkt_in: bitstring);
    let (p: bitstring, verdict: bitstring, sig: bitstring, k: key, c_sig: bitstring) = adec(pkt_in, g1_sk) in
    let (verdict_checked: bitstring, wrapped_checked: bitstring) = checksign(sig, pk(v_sign_sk)) in
    if verdict_checked = verdict then
    (
        let p_confirmed = sdec(wrapped_checked, k) in
        let (c_p: bitstring, c_verdict: bitstring) = checksign(c_sig, pk(c_sign_sk)) in
        if (p_confirmed = p) && (c_p = p) && (c_verdict = verdict) then
        (
            let g1_signed = sign(c_sig, g1_sign_sk) in
            ( out(match_board_1, g1_signed) | out(match_board_1, g1_signed) )
        )
    ).

let gatekeeper_2 =
    !
    in(pub, pkt_in: bitstring);
    let (p: bitstring, verdict: bitstring, sig: bitstring, k: key, c_sig: bitstring) = adec(pkt_in, g2_sk) in
    let (verdict_checked: bitstring, wrapped_checked: bitstring) = checksign(sig, pk(v_sign_sk)) in
    if verdict_checked = verdict then
    (
        let p_confirmed = sdec(wrapped_checked, k) in
        let (c_p: bitstring, c_verdict: bitstring) = checksign(c_sig, pk(c_sign_sk)) in
        if (p_confirmed = p) && (c_p = p) && (c_verdict = verdict) then
        (
            let g2_signed = sign(c_sig, g2_sign_sk) in
            ( out(match_board_2, g2_signed) | out(match_board_2, g2_signed) )
        )
    ).

let gatekeeper_3 =
    !
    in(pub, pkt_in: bitstring);
    let (p: bitstring, verdict: bitstring, sig: bitstring, k: key, c_sig: bitstring) = adec(pkt_in, g3_sk) in
    let (verdict_checked: bitstring, wrapped_checked: bitstring) = checksign(sig, pk(v_sign_sk)) in
    if verdict_checked = verdict then
    (
        let p_confirmed = sdec(wrapped_checked, k) in
        let (c_p: bitstring, c_verdict: bitstring) = checksign(c_sig, pk(c_sign_sk)) in
        if (p_confirmed = p) && (c_p = p) && (c_verdict = verdict) then
        (
            let g3_signed = sign(c_sig, g3_sign_sk) in
            ( out(match_board_3, g3_signed) | out(match_board_3, g3_signed) )
        )
    ).

let quorum_12 =
    !
    in(match_board_1, s1: bitstring);
    in(match_board_2, s2: bitstring);
    let c1 = checksign(s1, pk(g1_sign_sk)) in
    let (p1: bitstring, v1: bitstring) = checksign(c1, pk(c_sign_sk)) in
    let c2 = checksign(s2, pk(g2_sign_sk)) in
    let (p2: bitstring, v2: bitstring) = checksign(c2, pk(c_sign_sk)) in
    if (p1 = p2) && (v1 = v2) then
    ( ( out(quorum_out, (p1, v1)) | out(quorum_out, (p1, v1)) ) ).

let quorum_13 =
    !
    in(match_board_1, s1: bitstring);
    in(match_board_3, s3: bitstring);
    let c1 = checksign(s1, pk(g1_sign_sk)) in
    let (p1: bitstring, v1: bitstring) = checksign(c1, pk(c_sign_sk)) in
    let c3 = checksign(s3, pk(g3_sign_sk)) in
    let (p3: bitstring, v3: bitstring) = checksign(c3, pk(c_sign_sk)) in
    if (p1 = p3) && (v1 = v3) then
    ( ( out(quorum_out, (p1, v1)) | out(quorum_out, (p1, v1)) ) ).

let quorum_23 =
    !
    in(match_board_2, s2: bitstring);
    in(match_board_3, s3: bitstring);
    let c2 = checksign(s2, pk(g2_sign_sk)) in
    let (p2: bitstring, v2: bitstring) = checksign(c2, pk(c_sign_sk)) in
    let c3 = checksign(s3, pk(g3_sign_sk)) in
    let (p3: bitstring, v3: bitstring) = checksign(c3, pk(c_sign_sk)) in
    if (p2 = p3) && (v2 = v3) then
    ( ( out(quorum_out, (p2, v2)) | out(quorum_out, (p2, v2)) ) ).

let content_matcher_f =
    !
    in(pub, enc_content_in: bitstring);
    let (h: bitstring, n: bitstring) = adec(enc_content_in, f_device_sk) in
    let candidate = hash((h, n)) in
    in(quorum_out, (posted: bitstring, v_posted: bitstring));
    if candidate = posted then
    (
        out(registry, (h, v_posted))
    ).

let content_matcher_i =
    !
    in(pub, enc_content_in: bitstring);
    let (h: bitstring, n: bitstring) = adec(enc_content_in, i_device_sk) in
    let candidate = hash((h, n)) in
    in(quorum_out, (posted: bitstring, v_posted: bitstring));
    if candidate = posted then
    (
        out(registry, (h, v_posted))
    ).


process
    out(pub, pk(v_token_sk));
    out(pub, pk(v_sign_sk));
    out(pub, c_device_sk);
    out(pub, c_sign_sk);
    out(pub, pk(f_device_sk));
    out(pub, pk(i_device_sk));
    out(pub, pk(g1_sk));
    out(pub, pk(g1_sign_sk));
    out(pub, pk(g2_sk));
    out(pub, pk(g2_sign_sk));
    out(pub, pk(g3_sk));
    out(pub, pk(g3_sign_sk));
    (
        device(choice[T1,T2], imgX, claimX)
        | device(choice[T2,T1], imgY, claimY)
        | validator
        | gatekeeper_1
        | gatekeeper_2
        | gatekeeper_3
        | quorum_12
        | quorum_13
        | quorum_23
        | content_matcher_f
        | content_matcher_i
    )
