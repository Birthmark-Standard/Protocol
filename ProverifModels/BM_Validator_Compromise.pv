(* BM_Validator_Compromise.pv
   Tests whether a compromised credential validator can determine
   which device produced which content.

   Both of the validator's keys are leaked together: v_token_sk (used
   to decrypt the token) and v_sign_sk (used to sign approval, A3).
   These are modeled as two separate keys, not one key doing both
   jobs, and both are tested compromised at once, since a real
   "compromised validator" most plausibly means the whole server, not
   one isolated key recovered in isolation. c_device_sk (the
   credential processor's key) stays private.

   C still generates BlindShare_key and wraps PacketHash into it
   itself, exactly as before. The validator, even holding both its
   own keys, never holds BlindShare_key: that key is generated and
   kept by the credential processor, in a path the validator never
   sees. Decrypting the token gives the validator a device identity
   directly, and forging an approval signature over any wrapped value
   it chooses, but the wrapped value stays opaque without
   BlindShare_key to open it, so neither compromised key gives the
   validator anything to check a recovered device identity against.

   Companion to BM_CredentialProcessor_Compromise.pv, which tests the
   reverse single-component compromise. Compromising both the
   validator and the credential processor together is not modeled
   here; combining their views trivially yields correlation, since
   the validator would then hold a readable device identity and the
   credential processor already holds PacketHash and BlindShare_key
   for the same transaction.

   Result: observational equivalence holds. A compromised validator,
   even holding the device's identity in the clear and able to forge
   its own approval signature, gains no way to link either to specific
   content. *)

type skey.
type pkey.
type key.

fun pk(skey): pkey.
fun aenc(bitstring, pkey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey, rnd: bitstring; adec(aenc(m, pk(sk), rnd), sk) = m.

fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, sk: skey; checksign(sign(m, sk), pk(sk)) = m.

fun hash(bitstring): bitstring.

free pub: channel.

free v_token_sk: skey [private].
free v_sign_sk: skey [private].
free c_device_sk: skey [private].
free f_device_sk: skey [private].

free tag_approved: bitstring.

free T1: bitstring [private].
free T2: bitstring [private].
free imgX: bitstring.
free imgY: bitstring.

let device(token: bitstring, content: bitstring) =
    let h = hash(content) in
    new n: bitstring;
    let packethash = hash((h, n)) in
    new rnd_token: bitstring;
    let enc_token = aenc(token, pk(v_token_sk), rnd_token) in
    new rnd_bundle: bitstring;
    let enc_bundle = aenc((enc_token, packethash), pk(c_device_sk), rnd_bundle) in
    new rnd_content: bitstring;
    let enc_content = aenc((h, n), pk(f_device_sk), rnd_content) in
    out(pub, enc_content);
    out(pub, enc_bundle).

let credential_processor =
    !
    in(pub, enc_bundle_in: bitstring);
    let (enc_token_in: bitstring, packethash_in: bitstring) = adec(enc_bundle_in, c_device_sk) in
    new blindshare_key: key;
    let wrapped = senc(packethash_in, blindshare_key) in
    out(pub, (enc_token_in, wrapped)).

let validator =
    !
    in(pub, (enc_token_in: bitstring, wrapped_in: bitstring));
    let token_in = adec(enc_token_in, v_token_sk) in
    if (token_in = T1) || (token_in = T2) then
        out(pub, sign((tag_approved, wrapped_in), v_sign_sk)).

process
    out(pub, pk(c_device_sk));
    out(pub, v_token_sk);
    out(pub, v_sign_sk);
    out(pub, pk(f_device_sk));
    (
        device(choice[T1,T2], imgX)
        | device(choice[T2,T1], imgY)
        | credential_processor
        | validator
    )
