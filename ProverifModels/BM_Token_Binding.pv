(* BM_Token_Binding.pv   (v105 design, token binding)
Property L: the credential validator issues a verdict for a wrapped FullPacketHash only if the device that sent the token committed to that wrapped value.

Vantage point: the credential channel server C is compromised. The adversary plays C. It receives everything C receives from the device (the token, the
FullPacketHash and BlindShare_key) and may send the validator any token and any wrapped value, including a genuine token paired with a wrapped value of its own.
The token is encrypted to the validator, so the adversary cannot read or build one; it can only pass along tokens the device made.

What the device does: it generates BlindShare_key, wraps FullPacketHash under it to form the wrapped value, hashes the wrapped value to form the binding hash, and puts the
binding hash in the token with its credential, a replay nonce and its claim. The wrap is deterministic given BlindShare_key, as the gatekeepers' recomputation requires.

What the validator does: it decrypts the token, checks the credential, and compares the binding hash with the hash of the wrapped value it was handed. A verdict event is recorded only if both checks pass.

What the queries ask: (1) whether a verdict is ever issued for a (replay nonce, wrapped value) pair that the device did not commit to; (2) whether a verdict can be issued at all, so that (1) is not true merely because nothing happens.
The credential is a private name that stands for one registered device credential. Membership is modeled as equality with it. The replay log is not modeled; each genuine token is a distinct nonce.

Expected: query (1) true and query (2) false (an issuing run exists) on the model; query (1) false on the twin. The twin must fail, or this model's "true" proves nothing. *)

type skey.
type pkey.
type key.

fun pk(skey): pkey.
fun aenc(bitstring, pkey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey, rnd: bitstring; adec(aenc(m, pk(sk), rnd), sk) = m.

fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

fun hash(bitstring): bitstring.

free pub: channel.

free v_token_sk: skey [private].
free cred: bitstring [private].
free claim: bitstring.

event dev_committed(bitstring, bitstring).
event v_issued(bitstring, bitstring).

query rn: bitstring, e: bitstring; event(v_issued(rn, e)) ==> event(dev_committed(rn, e)).
query rn: bitstring, e: bitstring; event(v_issued(rn, e)).

let device =
    !
    new rn: bitstring;
    new fullpackethash: bitstring;
    new blindshare_key: key;
    let wrapped_dev = senc(fullpackethash, blindshare_key) in
    let binding = hash(wrapped_dev) in
    event dev_committed(rn, wrapped_dev);
    new rnd_token: bitstring;
    let enc_token = aenc((cred, rn, claim, binding), pk(v_token_sk), rnd_token) in
    out(pub, (enc_token, fullpackethash, blindshare_key)).

let validator =
    !
    in(pub, (enc_token_in: bitstring, wrapped_in: bitstring));
    let (cred_in: bitstring, rn_in: bitstring, claim_in: bitstring, binding_in: bitstring) = adec(enc_token_in, v_token_sk) in
    if (cred_in = cred) && (binding_in = hash(wrapped_in)) then
        event v_issued(rn_in, wrapped_in).

process
    out(pub, pk(v_token_sk));
    (
        device
        | validator
    )
