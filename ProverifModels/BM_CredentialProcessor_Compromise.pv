(* BM_CredentialProcessor_Compromise.pv
   Tests whether a compromised credential processor (C) can determine
   which device produced which content.

   c_device_sk, C's own relay-terminus key, is leaked to the
   adversary, giving it PacketHash in the clear, exactly as C would
   legitimately hold it, and its own freshly-generated BlindShare_key.
   v_token_sk (the validator's decryption key) stays private, so the
   device's token remains opaque even to a fully compromised C.

   C generates BlindShare_key itself, the same as before: C is the
   party that later has to unwrap and verify whatever the validator
   signs, so C has to be the one holding the key from the start, not
   receiving it pre-generated from the device. C's own submission-
   server signing key (c_sign_sk) and the validator's separate signing
   key (v_sign_sk, A3) are omitted here: they gate whether C is willing
   to sign a PacketHash and whether the validator approves it, which is
   a posting-integrity question tested separately
   (BM_Quorum_Forgery.pv, BM_Quorum_Collusion.pv), not a correlation
   question, so it has no bearing on what this model tests.

   The C-to-validator round trip is omitted here: it only ever touches
   enc_token, which stays opaque to C either way, since C never holds
   v_token_sk, so modeling the round trip would not change what a
   compromised C can extract.

   Result: observational equivalence holds. Holding PacketHash and
   BlindShare_key in the clear does not, by itself, reveal which
   device produced it. *)

type skey.
type pkey.
type key.

fun pk(skey): pkey.
fun aenc(bitstring, pkey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey, rnd: bitstring; adec(aenc(m, pk(sk), rnd), sk) = m.

fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

fun hash(bitstring): bitstring.

free pub: channel.

free v_token_sk: skey [private].
free c_device_sk: skey [private].
free f_device_sk: skey [private].

free T1: bitstring [private].
free T2: bitstring [private].
free imgX: bitstring.
free imgY: bitstring.

let device(token: bitstring, content: bitstring) =
    let h = hash(content) in
    new n: bitstring;
    let packethash = hash((h, n)) in
    new rnd_token: bitstring;
    let enc_token = aenc(token, pk(v_token_sk), rnd_token) in
    new rnd_bundle: bitstring;
    let enc_bundle = aenc((enc_token, packethash), pk(c_device_sk), rnd_bundle) in
    new rnd_content: bitstring;
    let enc_content = aenc((h, n), pk(f_device_sk), rnd_content) in
    out(pub, enc_content);
    out(pub, enc_bundle).

let credential_processor =
    !
    in(pub, enc_bundle_in: bitstring);
    let (enc_token_in: bitstring, packethash_in: bitstring) = adec(enc_bundle_in, c_device_sk) in
    new blindshare_key: key;
    let wrapped = senc(packethash_in, blindshare_key) in
    out(pub, (enc_token_in, wrapped)).

process
    out(pub, pk(v_token_sk));
    out(pub, c_device_sk);
    out(pub, pk(f_device_sk));
    (
        device(choice[T1,T2], imgX)
        | device(choice[T2,T1], imgY)
        | credential_processor
    )
